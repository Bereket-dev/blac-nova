rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /categories/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /projects/{slug} {
      allow read: if resource.data.published == true || request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
      // Allow list/query for authenticated admin (includes drafts)
      allow list: if request.auth != null
        || resource.data.published == true;
    }
    match /inquiries/{id} {
      // Public: no direct client writes — all writes go through the server action
      //         (Firebase Admin SDK bypasses these rules)
      allow read, update: if request.auth != null;
      allow create: if false; // server action only
      allow delete: if request.auth != null;
    }
    match /testimonials/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
